# Prefer an absolute path on a real local disk (not Google Drive / Dropbox).
# Example:
# DATABASE_URL="file:/Users/you/.local/share/mafia-invitees/mafia.db"
DATABASE_URL="file:../data/mafia.db"

# Shared team password
APP_PASSWORD="replace-with-a-strong-shared-password"

# Used to sign the login cookie
SESSION_SECRET="replace-with-a-long-random-string"

# --- Hourly invite-addition email digest (optional) ---
# Sends at most one email per hour, and only if someone was added to an event.
# Free Resend account: https://resend.com — until you verify a domain, EMAIL_FROM
# must stay onboarding@resend.dev and NOTIFY_EMAIL must be your Resend account email.
NOTIFY_EMAIL="you@example.com"
RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Mafia Invite Desk <onboarding@resend.dev>"
# Optional: protect manual/external cron hits to /api/cron/invite-digest
# CRON_SECRET="replace-with-a-long-random-string"

# --- Netlify / production (Turso hosted SQLite) ---
# When TURSO_DATABASE_URL is set, the app uses Turso instead of the local file.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"
